{
  "headers": [
    {
      "source": "/demo/evidence/(.*)\\.jsonl",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-ndjson; charset=utf-8"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
